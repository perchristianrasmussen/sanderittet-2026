---
// Bunntekst: ordmerket, lenker til alle sidene, adressen og koblingen til moderklubben.
import { adresse, moderklubbUrl } from '../data/klubb.ts';

const lenker = [
  { href: '/trening', tekst: 'Trening' },
  { href: '/loyper', tekst: 'Løyper' },
  { href: '/sanderittet', tekst: 'Sanderittet' },
  { href: '/nm2026', tekst: 'NM 2026' },
  { href: '/historikk', tekst: 'Historikk' },
  { href: '/sponsorer', tekst: 'Sponsorer' },
];
---

<footer class="footer on-dark">
  <div class="container footer-inner">
    <div>
      <p class="footer-brand">Sande <b>Sykkel</b>klubb</p>
      <p class="label">Lersbrygga <span class="sep">·</span> {adresse.poststed}</p>
    </div>
    <nav aria-label="Sidene">
      <ul class="footer-lenker">
        {lenker.map((l) => <li><a href={l.href} class="link">{l.tekst}</a></li>)}
      </ul>
    </nav>
    <p class="label">En del av <a href={moderklubbUrl}>Sande Sportsklubb</a></p>
  </div>
</footer>

<style>
  .footer {
    border-top: 3px solid var(--red);
    padding-block: 2.5rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: var(--fs-brand);
    letter-spacing: 0.04em;
  }

  .footer-brand b {
    font-weight: 400;
    color: var(--red);
  }

  .footer-lenker {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-md);
    padding: 0;
    list-style: none;
  }

  .footer-lenker a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-cond);
    font-size: var(--fs-tag);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer a {
    color: var(--white);
  }

  /* Hvit også ved hover; den delte streken tegnes inn (red-light gir 4,2:1 på dark) */
  .footer a:hover {
    color: var(--white);
  }
</style>
