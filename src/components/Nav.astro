---
// Hovedmeny. Under 760px blir lista en hamburgermeny når skriptet har lastet;
// uten JS står lenkene synlige under logoen.
import { Image } from 'astro:assets';
import Icon from './ui/Icon.astro';
import logo from '../assets/img/sandelogo.png';

type Side = 'trening' | 'loyper' | 'sanderittet' | 'historikk';

interface Props {
  /** Siden vi står på; gir aria-current på lenken. */
  current?: Side;
  /** Ligger over hero med glass i stedet for på egen mørk flate. */
  overlay?: boolean;
}

const { current, overlay = false } = Astro.props;

const links: { id: Side; href: string; text: string }[] = [
  { id: 'trening', href: '/trening', text: 'Trening' },
  { id: 'loyper', href: '/loyper', text: 'Løyper' },
  { id: 'sanderittet', href: '/sanderittet', text: 'Sanderittet' },
  { id: 'historikk', href: '/historikk', text: 'Historikk' },
];
---

<header class:list={['site-header', { overlay }]} data-site-header>
  <nav class="nav" aria-label="Hovedmeny">
    <a href="/" class="nav-brand">
      <Image src={logo} alt="" width={40} height={40} loading="eager" />
      <span>Sande <b>Sykkel</b></span>
    </a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="hovedmeny" hidden>
      <Icon name="menu" size={22} class="ikon-meny" />
      <Icon name="x" size={22} class="ikon-lukk" />
      <span data-nav-toggle-text>Meny</span>
    </button>
    <ul id="hovedmeny" class="nav-menu">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.text}</a>
        </li>
      ))}
      <li class="nav-cta-item"><a href="/trening#bli-med" class="nav-cta">Bli med</a></li>
    </ul>
  </nav>
</header>

<script>
  for (const header of document.querySelectorAll<HTMLElement>('[data-site-header]')) {
    const knapp = header.querySelector<HTMLButtonElement>('.nav-toggle');
    const tekst = header.querySelector('[data-nav-toggle-text]');
    if (!knapp || !tekst) continue;

    const settApen = (apen: boolean) => {
      header.toggleAttribute('data-open', apen);
      knapp.setAttribute('aria-expanded', String(apen));
      tekst.textContent = apen ? 'Lukk meny' : 'Meny';
    };

    header.dataset.enhanced = '';
    knapp.hidden = false;
    knapp.addEventListener('click', () => settApen(knapp.getAttribute('aria-expanded') !== 'true'));

    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        settApen(false);
        knapp.focus();
      }
    });

    document.addEventListener('click', (e) => {
      if (header.hasAttribute('data-open') && !header.contains(e.target as Node)) settApen(false);
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background: var(--dark);
  }

  /* Over hero: under trefargestripen, med glass */
  .site-header.overlay {
    position: absolute;
    top: 4px;
    left: 0;
    right: 0;
    background: rgba(13, 24, 36, 0.55);
    backdrop-filter: blur(10px);
  }

  .site-header :focus-visible {
    outline-color: var(--white);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.7rem var(--gutter);
    border-bottom: 2px solid var(--red);
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--white);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .nav-brand:hover {
    color: var(--white);
  }

  .nav-brand b {
    font-weight: 400;
    color: var(--red);
  }

  .nav-menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.25rem;
    list-style: none;
    padding: 0;
  }

  .nav-menu a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    font-family: var(--font-cond);
    font-size: var(--fs-nav);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    /* Rød strek i bunnen som tegnes fra venstre */
    background: linear-gradient(var(--red), var(--red)) no-repeat 0 100% / 0% 2px;
    transition:
      color var(--t-fast),
      background-size var(--t-lift) var(--ease-out-expo);
  }

  .nav-menu a:hover,
  .nav-menu a[aria-current='page'] {
    color: var(--white);
    background-size: 100% 2px;
  }

  .nav-menu .nav-cta {
    padding-inline: 1rem;
    margin-left: 0.5rem;
    background: var(--red);
    color: var(--white);
    border-radius: var(--r-sm);
    font-weight: 700;
    transition:
      background-color var(--t-fast),
      transform var(--t-fast) var(--ease-out-expo);
  }

  .nav-menu .nav-cta:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
  }

  .nav-menu .nav-cta:active {
    transform: scale(0.98);
    transition-duration: var(--t-press);
  }

  .nav-toggle {
    display: none;
  }

  @media (max-width: 760px) {
    /* Uten JS: lenkene på egen rad under logoen */
    .nav-menu {
      width: 100%;
      gap: 0 0.75rem;
    }

    .nav-menu .nav-cta {
      margin-left: 0;
    }

    /* Med JS: hamburgerknapp og mørk nedtrekksliste */
    [data-enhanced] .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-width: 44px;
      min-height: 44px;
      padding: 0 0.75rem;
      font-family: var(--font-cond);
      font-size: var(--fs-nav);
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--white);
      background: transparent;
      border: 1px solid var(--line-on-dark-strong);
      border-radius: var(--r-sm);
      cursor: pointer;
    }

    .nav-toggle :global(.ikon-lukk),
    [data-open] .nav-toggle :global(.ikon-meny) {
      display: none;
    }

    [data-open] .nav-toggle :global(.ikon-lukk) {
      display: block;
    }

    [data-enhanced] .nav-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) var(--s-md);
      background: var(--dark);
      border-bottom: 2px solid var(--red);
    }

    [data-open] .nav-menu {
      display: flex;
    }

    [data-enhanced] .nav-menu a {
      display: flex;
      min-height: 56px;
      padding-inline: 0;
      font-size: 1.375rem;
      border-bottom: 1px solid var(--line-on-dark);
    }

    /* I panelet markeres siden med strek til venstre; bunnstreken er bare for hover */
    [data-enhanced] .nav-menu a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--red);
      padding-left: 0.75rem;
      background-size: 0% 2px;
    }

    [data-enhanced] .nav-menu a:hover {
      background-size: 100% 2px;
    }

    [data-enhanced] .nav-cta-item {
      margin-top: var(--s-md);
    }

    [data-enhanced] .nav-menu .nav-cta {
      justify-content: center;
      border-bottom: 0;
    }
  }
</style>
