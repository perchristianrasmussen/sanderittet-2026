---
import Banner from './ui/Banner.astro';
import { treningsplan } from '../data/trening.ts';
import { nesteTrening } from '../lib/nesteTrening.ts';

// Byggeverdien vises uten JS; skriptet under regner ut på nytt ved lasting,
// så en statisk side ikke blir stående med en utgått treningstid.
const neste = nesteTrening(new Date(), treningsplan);
const planJson = JSON.stringify(treningsplan).replace(/</g, '\u003c');
---

<Banner label={neste.label} value={neste.value} datetime={neste.datetime} state={neste.state} data-neste-trening />
<script type="application/json" id="treningsplan" is:inline set:html={planJson} />

<script>
  import { nesteTrening, type Treningsplan } from '../lib/nesteTrening.ts';
  import { byttBanner } from '../lib/byttBanner.ts';

  const data = document.getElementById('treningsplan')?.textContent;
  if (data) {
    const neste = nesteTrening(new Date(), JSON.parse(data) as Treningsplan);
    for (const banner of document.querySelectorAll<HTMLElement>('[data-neste-trening]')) {
      byttBanner(banner, neste);
    }
  }
</script>
