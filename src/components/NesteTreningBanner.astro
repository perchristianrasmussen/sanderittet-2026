---
import Banner from './ui/Banner.astro';
import { treningsplan, yngsteGruppe } from '../data/trening.ts';
import { nesteTrening } from '../lib/nesteTrening.ts';

interface Props {
  size?: 'md' | 'sm';
}

const { size } = Astro.props;

// Byggeverdien vises uten JS; skriptet under regner ut på nytt ved lasting,
// så en statisk side ikke blir stående med en utgått treningstid.
const neste = nesteTrening(new Date(), treningsplan, yngsteGruppe);
const planJson = JSON.stringify(treningsplan).replace(/</g, '\\u003c');
---

<Banner label={neste.label} value={neste.value} datetime={neste.datetime} state={neste.state} size={size} data-neste-trening />
<script type="application/json" id="treningsplan" data-gruppe={yngsteGruppe} is:inline set:html={planJson} />

<script>
  import { nesteTrening, type Treningsplan } from '../lib/nesteTrening.ts';
  import { byttBanner } from '../lib/byttBanner.ts';

  const kilde = document.getElementById('treningsplan');
  const data = kilde?.textContent;
  if (data) {
    const neste = nesteTrening(new Date(), JSON.parse(data) as Treningsplan, kilde?.dataset.gruppe);
    for (const banner of document.querySelectorAll<HTMLElement>('[data-neste-trening]')) {
      byttBanner(banner, neste);
    }
  }
</script>
