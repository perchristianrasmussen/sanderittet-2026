---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'outline-light';
  icon?: IconName;
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', icon, external = false, class: className } = Astro.props;
const trailing = icon ?? (external ? 'external-link' : undefined);
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, className]}
  {...external ? { target: '_blank', rel: 'noopener' } : {}}
>
  <slot />
  {external && <span class="visually-hidden"> (åpnes i ny fane)</span>}
  {trailing && <Icon name={trailing} size={18} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0.9rem 1.75rem;
    font-family: var(--font-cond);
    font-size: var(--fs-button);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--r-sm);
    border: 1.5px solid transparent;
    transition:
      background-color var(--t-fast),
      border-color var(--t-fast),
      transform var(--t-fast) var(--ease-out-expo);
  }

  /* Løftes ved hover, trykkes ned ved klikk */
  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: scale(0.98);
    transition-duration: var(--t-press);
  }

  .btn-primary {
    background: var(--red);
    color: var(--white);
  }

  /* Mørkere ved hover, så hvit tekst holder AA (8:1) */
  .btn-primary:hover {
    background: var(--red-dark);
    color: var(--white);
  }

  .btn-outline {
    color: var(--white);
    border-color: var(--line-on-dark-strong);
  }

  .btn-outline:hover {
    color: var(--white);
    border-color: var(--white);
  }

  .btn-outline-light {
    color: var(--blue);
    border-color: var(--blue);
  }

  .btn-outline-light:hover {
    color: var(--white);
    background: var(--blue);
  }
</style>
