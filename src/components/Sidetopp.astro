---
// Toppen på undersidene: H1 med ett rødt ord, aksentstrek og ingress, på mørk arenaflate.
// Med bilde ligger teksten nederst til venstre over klubbfotoet, med samme arenagradient som heroen.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import AccentBar from './ui/AccentBar.astro';

interface Props {
  /** Id til H1, brukes av aria-labelledby. */
  id?: string;
  bilde?: ImageMetadata;
  bildeAlt?: string;
  /** object-position for bildet, f.eks. "50% 40%". */
  fokus?: string;
}

const { id = 'side-tittel', bilde, bildeAlt = '', fokus = '50% 50%' } = Astro.props;
---

<section class:list={['sidetopp', 'on-dark', { 'med-bilde': bilde }]} aria-labelledby={id}>
  {
    bilde && (
      <>
        <Image src={bilde} alt={bildeAlt} class="sidetopp-foto" style={`object-position: ${fokus}`} widths={[800, 1400, 2200]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="sidetopp-skygge" aria-hidden="true" />
      </>
    )
  }
  <div class="container sidetopp-innhold">
    <h1 id={id} class="headline"><slot name="tittel" /></h1>
    <AccentBar />
    <slot />
  </div>
</section>

<style>
  .sidetopp {
    position: relative;
    padding-block: var(--s-xl) var(--s-lg);
    isolation: isolate;
    overflow: hidden;
  }

  .med-bilde {
    display: flex;
    align-items: flex-end;
    min-height: clamp(26rem, 64vh, 40rem);
    padding-top: var(--s-section);
  }

  .sidetopp :global(.sidetopp-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Samme arenagradient som heroen, og en lokal skygge bak teksten nede til venstre */
  .sidetopp-skygge {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 80% at 0% 100%, rgba(13, 24, 36, 0.8), rgba(13, 24, 36, 0.35) 60%, transparent 85%),
      linear-gradient(180deg, rgba(13, 24, 36, 0.55) 0%, rgba(13, 24, 36, 0.1) 35%, rgba(13, 24, 36, 0.45) 65%, rgba(13, 24, 36, 0.95) 100%);
  }

  .sidetopp h1 {
    font-size: var(--fs-display-sm);
    line-height: 0.9;
  }

  .med-bilde h1 {
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.6);
  }

  .sidetopp-innhold :global(.lead) {
    margin-top: var(--s-md);
    color: var(--soft-on-dark);
  }

  .sidetopp-innhold > :global(:last-child:not(.lead, .accent-bar)) {
    margin-top: var(--s-md);
  }

  /* Tittelen setter seg ved lasting, som heroen, men uten resten av entreen */
  .sidetopp h1 {
    animation: sett 700ms var(--ease-out-expo) backwards;
  }

  @keyframes sett {
    from {
      transform: translateY(16px);
    }
  }

  @media (max-width: 760px) {
    .sidetopp-skygge {
      background: linear-gradient(180deg, rgba(13, 24, 36, 0.5) 0%, rgba(13, 24, 36, 0.55) 40%, rgba(13, 24, 36, 0.92) 100%);
    }
  }

  @media (min-width: 761px) {
    .sidetopp h1 {
      font-size: var(--fs-display-page);
    }
  }
</style>
