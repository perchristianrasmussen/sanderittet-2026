---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import Tag from '../components/ui/Tag.astro';
import StatPanel from '../components/ui/StatPanel.astro';
import Banner from '../components/ui/Banner.astro';
import NesteTreningBanner from '../components/NesteTreningBanner.astro';
import Nav from '../components/Nav.astro';
import AccentBar from '../components/ui/AccentBar.astro';
import Icon, { type IconName } from '../components/ui/Icon.astro';
import heroPhoto from '../assets/img/rytter-sti.jpg';
import treningPhoto from '../assets/img/trening.jpg';

const colorGroups = [
  {
    name: 'Klubbfarger',
    items: [
      { token: 'red', hex: '#C8241A', name: 'Rittrød', role: 'Handling, ett rødt ord, grafikkens nøkkel' },
      { token: 'red-dark', hex: '#9E1A12', name: 'Dyp rittrød', role: 'Hover på røde knapper, feiltekst' },
      { token: 'red-light', hex: '#E8342A', name: 'Lys rittrød', role: 'Løypelinjer og fremdrift på mørkt' },
      { token: 'blue', hex: '#16397A', name: 'Klubbblå', role: 'Informasjon og CTA-paneler' },
      { token: 'blue-mid', hex: '#1E4EA6', name: 'Mellomblå', role: 'Lenker og fokus' },
      { token: 'blue-pale', hex: '#E8EEF8', name: 'Blekblå', role: 'Lyse klubbseksjoner' },
    ],
  },
  {
    name: 'Arena og flater',
    items: [
      { token: 'dark', hex: '#0D1824', name: 'Arenamørk', role: 'Nav, hero, arenaseksjoner' },
      { token: 'night', hex: '#07090D', name: 'Natt', role: 'Kart og 3D' },
      { token: 'text', hex: '#1A2030', name: 'Blekk', role: 'Brødtekst' },
      { token: 'muted', hex: '#5A6580', name: 'Grus', role: 'Sekundærtekst' },
      { token: 'off-white', hex: '#F6F7F9', name: 'Off-white', role: 'Sidebakgrunn' },
    ],
  },
  {
    name: 'Løypefarger (kun i kart)',
    items: [
      { token: 'route-start', hex: '#E6C120', name: 'Startloop', role: '' },
      { token: 'route-green', hex: '#1A9E5C', name: 'Grønn', role: 'Yngste klasser' },
      { token: 'route-blue', hex: '#3A9EFF', name: 'Blå', role: '10–12 år' },
      { token: 'route-red', hex: '#C8241A', name: 'Rød', role: 'XCO 13+' },
      { token: 'route-orange', hex: '#E87820', name: 'Oransje', role: 'XCC fra 15 år' },
    ],
  },
];

const iconNames: IconName[] = ['arrow-right', 'arrow-down', 'external-link', 'map-pin', 'calendar', 'clock', 'download', 'mail', 'bike', 'mountain', 'play', 'alert-circle', 'menu', 'x'];

// Eksempeldata for høydeprofilen – ikke ekte løypetall.
const profile = [24, 26, 31, 35, 33, 38, 44, 49, 46, 41, 43, 50, 57, 61, 58, 52, 47, 44, 40, 36, 33, 30, 27, 25];
const w = 1000;
const h = 120;
const max = Math.max(...profile);
const min = Math.min(...profile);
const pts = profile.map((v, i) => [(i / (profile.length - 1)) * w, h - ((v - min) / (max - min)) * (h - 20) - 10]);
const line = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `0,${h} ${line} ${w},${h}`;
const progressX = w * 0.58;
---

<Base title="Designprofil – Sande Sykkelklubb">
  <Nav overlay />

  <main id="innhold">
    <!-- Forsidens første skjerm, slik den er tenkt -->
    <section class="hero on-dark" aria-labelledby="hero-title">
      <Image src={heroPhoto} alt="Ung rytter i Sande-drakt på vei ned en steinete sti i skogen" class="hero-photo" widths={[800, 1400, 2000, 2600]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-stripe" aria-hidden="true"></div>

      <div class="hero-body">
        <h1 id="hero-title" class="display">Sande <span class="hl">Sykkel</span>&shy;klubb</h1>
        <p class="hero-sub">Ukentlig sykkeltrening for barn og ungdom på Lersbrygga, fra påske til høstferie. Nybegynnere er velkomne, og foreldre kan gjerne bli med.</p>
        <!-- Status på egen linje, så handlingen under er det tyngste røde -->
        <div class="hero-status">
          <NesteTreningBanner size="sm" />
        </div>
        <div class="hero-action" id="bli-med">
          <p class="hero-note" id="spond-forklaring">Vi bruker appen Spond til påmelding og beskjeder. Knappen åpner gruppa vår.</p>
          <Button href="https://group.spond.com/OXGYJ" external size="lg" class="hero-cta" aria-describedby="spond-forklaring">Bli med i Spond</Button>
        </div>
      </div>

      <ul class="hero-stats" aria-label="Arrangementer på Lersbrygga">
        <StatPanel as="li" label="Arrangør · Norgescup" value="2024" size="sm" />
        <StatPanel as="li" label="Arrangør · Norgescup" value="2025" size="sm" />
        <StatPanel as="li" label={'Arrangør · NM terreng'} value="2026" size="sm" />
      </ul>
    </section>

    <!-- Innledning og farger deler én lys flate, så lyst og mørkt veksler nedover siden -->
    <div class="on-light">
      <section class="section" aria-labelledby="profil">
        <div class="container">
          <h2 id="profil" class="headline">Designprofil <span class="hl">v2</span></h2>
          <AccentBar />
          <p class="lead">Dagens arenastil fra sanderittet.no, videreført med TV-grafikken fra løypepresentasjonen. Denne siden viser byggeklossene; fasit er DESIGN.md.</p>
        </div>
      </section>

      <section class="section section-joined" aria-labelledby="farger">
        <div class="container">
          <h2 id="farger" class="headline">Far<span class="hl">ger</span></h2>
          <AccentBar />
          {colorGroups.map((g) => (
            <div class="swatch-group">
              <h3 class="label">{g.name}</h3>
              <ul class="swatches">
                {g.items.map((c) => (
                  <li>
                    <span class="chip" style={`background:${c.hex}`}></span>
                    <strong>{c.name}</strong>
                    <span class="num meta">--{c.token} · {c.hex}</span>
                    {c.role && <span class="meta">{c.role}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    </div>

    <section class="section on-dark" aria-labelledby="typografi">
      <div class="container">
        <h2 id="typografi" class="headline">Typo<span class="hl">grafi</span></h2>
        <AccentBar />
        <div class="type-grid">
          <div class="type-row">
            <span class="label">Display · Bebas Neue</span>
            <p class="display type-display">Lersbrygga</p>
          </div>
          <div class="type-row">
            <span class="label">Headline · Bebas Neue</span>
            <p class="headline">Faste <span class="hl">treninger</span></p>
          </div>
          <div class="type-row">
            <span class="label">Title · Bebas Neue</span>
            <p class="title">Rundbane XCO</p>
          </div>
          <div class="type-row">
            <span class="label">Stat · Barlow Condensed 700</span>
            <p class="num type-stat">18:00 <small>MAN</small></p>
          </div>
          <div class="type-row">
            <span class="label">Banner · Barlow Condensed 800 kursiv</span>
            <p class="type-banner">Trening i dag</p>
          </div>
          <div class="type-row">
            <span class="label">Label · Barlow Condensed 600</span>
            <p class="label">Lersbrygga · Mandag &amp; torsdag</p>
          </div>
          <div class="type-row">
            <span class="label">Lead · Barlow 400</span>
            <p class="lead">Sande Sykkelklubb har faste treninger for alle aldre fra påske til høstferie.</p>
          </div>
          <div class="type-row">
            <span class="label">Body · Barlow 400</span>
            <p class="body-sample">Opp til 10 år trener mandager kl. 18:00–19:00, over 10 år kl. 18:00–19:30. Teknikk og moro i terrenget – foreldre er velkomne til å bli med. Påmelding og informasjon deles i Spond.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section on-pale" aria-labelledby="lyst">
      <div class="container">
        <h2 id="lyst" class="headline">På lyse <span class="hl">flater</span></h2>
        <AccentBar />

        <div class="demo-row">
          <Button href="#">Bli med på trening</Button>
          <Button href="#" variant="outline-light" icon="arrow-right">Se løypene</Button>
          <a href="#" class="link inline-link">Inline-lenke til Sande Sportsklubb</a>
        </div>

        <div class="demo-row">
          <Tag label="Trening" value="I dag" tone="dark" />
          <Tag label="XCC" value="Kortbane" tone="dark" />
          <Tag label="NM" value="2026" tone="dark" />
        </div>

        <div class="demo-row stats-row">
          <StatPanel label="Man · opptil 10 år" value="18:00" unit="–19:00" tone="light" />
          <StatPanel label="Man · over 10 år" value="18:00" unit="–19:30" tone="light" />
          <StatPanel label="Tor · 11 år og eldre" value="18:00" unit="–19:30" tone="light" />
        </div>

        <div class="demo-grid">
          <article class="card">
            <div class="card-day title">Man</div>
            <p class="label">Mandager · påske–høstferie</p>
            <h3 class="card-h">Trening for alle aldre</h3>
            <p class="card-p">Opp til 10 år kl. 18:00–19:00. Over 10 år kl. 18:00–19:30.</p>
          </article>

          <div class="panel-blue">
            <h3 class="title">Vil du bli med?</h3>
            <AccentBar />
            <p>Nye medlemmer er alltid velkomne – ta kontakt, så hjelper vi deg i gang.</p>
            <Button href="mailto:leder.sykkel@sandesk.no" icon="mail">Send oss en e-post</Button>
          </div>

          <form class="form-demo" onsubmit="return false">
            <label for="navn" class="label">Navn</label>
            <input id="navn" type="text" placeholder="Fornavn og etternavn" />
            <label for="kategori" class="label">Kategori</label>
            <input id="kategori" type="text" class="invalid" aria-invalid="true" aria-describedby="feil" value="" />
            <p id="feil" class="error"><Icon name="alert-circle" size={18} /> Fyll inn en kategori før du sender inn.</p>
          </form>
        </div>

        <!-- Bevegelse: klikkbart kort løftes, bilde i lenke zoomer i rammen -->
        <div class="motion-grid">
          <a href="#" class="card card-link">
            <div class="card-day title">Løyper</div>
            <p class="label">Lersbrygga · XCO og XCC</p>
            <p class="card-h">Se løypene <Icon name="arrow-right" size={18} /></p>
          </a>
          <a href="#" class="photo-frame motion-photo">
            <Image src={treningPhoto} alt="Klubbens ryttere på tur, med utsikt over havet" widths={[600, 900]} sizes="(max-width: 760px) 100vw, 600px" />
          </a>
        </div>
      </div>
    </section>

    <section class="section on-dark" aria-labelledby="morkt">
      <div class="container">
        <h2 id="morkt" class="headline">På mørke <span class="hl">flater</span></h2>
        <AccentBar />

        <div class="demo-row">
          <Button href="#">Om NM 2026</Button>
          <Button href="#" variant="outline" icon="arrow-right">Se historikken</Button>
        </div>

        <div class="demo-row">
          <Tag label="XCO" value="Rundbane" />
          <Tag label="Status" value="Avholdt" />
          <Banner label="Sesongen starter" value="Tor 1. april" />
        </div>

        <div class="hud">
          <p class="label hud-note">Eksempeldata – ikke ekte løypetall</p>
          <div class="hud-top">
            <div>
              <Tag label="XCO" value="Løypepresentasjon" />
              <p class="title hud-title">Rundbane</p>
            </div>
            <div class="hud-stats">
              <StatPanel label="Distanse" value="2,40" unit="KM" />
              <StatPanel label="Høyde" value="38" unit="MOH" />
              <StatPanel label="Stigning" value="+6" unit="%" />
            </div>
          </div>
          <div class="hud-controls">
            <button type="button"><Icon name="play" size={16} /> Spill av</button>
            <button type="button" aria-pressed="false" data-toggle>1×</button>
            <button type="button" aria-pressed="true" data-toggle>Topo</button>
          </div>
          <div class="profile">
            <span class="label profile-label">Høydeprofil</span>
            <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="prog" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" style="stop-color: var(--red-light); stop-opacity: 0.85" />
                  <stop offset="1" style="stop-color: var(--red-light); stop-opacity: 0.12" />
                </linearGradient>
                <clipPath id="done"><rect x="0" y="0" width={progressX} height={h} /></clipPath>
              </defs>
              <polygon points={area} fill="rgba(255,255,255,0.09)" />
              <polyline points={line} fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="2" vector-effect="non-scaling-stroke" />
              <g clip-path="url(#done)">
                <polygon points={area} fill="url(#prog)" />
                <polyline points={line} fill="none" style="stroke: var(--red-light)" stroke-width="3" vector-effect="non-scaling-stroke" />
              </g>
            </svg>
          </div>
        </div>

        <div class="info-cards">
          <div class="info-card">
            <span class="label">Adresse</span>
            <p>Lersbrygga Idrettsanlegg<br />3070 Sande i Vestfold</p>
          </div>
          <div class="info-card">
            <span class="label">Påmelding</span>
            <p>All påmelding og informasjon skjer i Spond.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section on-light" aria-labelledby="ikoner">
      <div class="container">
        <h2 id="ikoner" class="headline">Iko<span class="hl">ner</span></h2>
        <AccentBar />
        <ul class="icons">
          {iconNames.map((n) => (
            <li><Icon name={n} size={28} /><span class="label">{n}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <footer class="footer on-dark">
    <div class="container footer-inner">
      <div>
        <p class="footer-brand">Sande <b>Sykkel</b>klubb</p>
        <p class="label">Lersbrygga · 3070 Sande i Vestfold</p>
      </div>
      <p class="label">En del av <a href="https://sandesk.no/grupper/sykkel/">Sande Sportsklubb</a></p>
    </div>
  </footer>
</Base>

<script>
  // Demo: HUD-bryterne veksler aria-pressed.
  for (const knapp of document.querySelectorAll<HTMLButtonElement>('[data-toggle]')) {
    knapp.addEventListener('click', () => {
      knapp.setAttribute('aria-pressed', String(knapp.getAttribute('aria-pressed') !== 'true'));
    });
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-lg);
    /* Plass til navigasjonen over, også når menyen brytes til to linjer */
    padding: calc(var(--header-h) + var(--s-sm)) var(--gutter) clamp(2.5rem, 7vh, 5rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 35% 45%;
    z-index: -2;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(13, 24, 36, 0.7) 0%, rgba(13, 24, 36, 0.15) 30%, rgba(13, 24, 36, 0.35) 55%, rgba(13, 24, 36, 0.92) 100%),
      radial-gradient(ellipse 60% 55% at 85% 20%, rgba(22, 57, 122, 0.45), transparent 70%);
  }

  .hero-stripe {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--red) 0 33.3%, var(--white) 33.3% 66.6%, var(--blue) 66.6%);
  }

  /* Tallpanelene står øverst til høyre i flyten under navigasjonen; i DOM kommer de etter handlingen */
  .hero-stats {
    order: -1;
    align-self: flex-end;
    display: flex;
    gap: 6px;
    margin: 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .hero-body {
    max-width: 62rem;
  }

  .hero h1 {
    text-shadow: 0 6px 40px rgba(0, 0, 0, 0.6);
  }

  .hero-sub {
    margin-top: 0.75rem;
    font-size: var(--fs-sub);
    color: var(--soft-on-dark);
    max-width: 42ch;
    text-wrap: pretty;
  }

  /* Neste trening er en statuslinje, ikke en knapp: egen rad under underteksten */
  .hero-status {
    margin-top: var(--s-md);
  }

  /* Forklaringen står foran knappen og er bundet til den med aria-describedby */
  .hero-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: var(--s-md);
  }

  .hero-note {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--soft-on-dark);
    max-width: 42ch;
    text-wrap: pretty;
  }

  /* «På lufta»: én entré på ca. 1 s ved lasting, bare i heroen.
     Tittel og undertekst er synlige fra start og setter seg; grafikken viskes inn
     fra venstre (nøkkel, verdi, knapp), og tallpanelene faller ned ett og ett
     mens den røde topplinjen tegnes. Sluttilstanden er standardstilen, og
     fill-mode backwards gjør at ingenting blir hengende igjen etterpå. */
  .hero h1 {
    animation: settle 700ms var(--ease-out-expo) backwards;
  }

  .hero-sub {
    animation: settle-sm 640ms 60ms var(--ease-out-expo) backwards;
  }

  .hero-status :global(.bk) {
    animation: wipe-in 400ms 200ms var(--ease-out-expo) backwards;
  }

  .hero-status :global(.bv) {
    animation: wipe-in 400ms 300ms var(--ease-out-expo) backwards;
  }

  .hero-action :global(.hero-cta) {
    animation: wipe-in 380ms 400ms var(--ease-out-expo) backwards;
  }

  .hero-stats :global(.stat) {
    animation: drop-in 450ms 420ms var(--ease-out-expo) backwards;
  }

  .hero-stats :global(.stat)::before {
    animation: draw-rule 400ms 500ms var(--ease-out-expo) backwards;
  }

  .hero-stats :global(.stat:nth-child(2)) {
    animation-delay: 500ms;
  }

  .hero-stats :global(.stat:nth-child(2))::before {
    animation-delay: 580ms;
  }

  .hero-stats :global(.stat:nth-child(3)) {
    animation-delay: 580ms;
  }

  .hero-stats :global(.stat:nth-child(3))::before {
    animation-delay: 660ms;
  }

  @keyframes settle {
    from {
      transform: translateY(16px);
    }
  }

  @keyframes settle-sm {
    from {
      transform: translateY(12px);
    }
  }

  @keyframes wipe-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  /* Faller 10px; avstanden til det som står over (nav på desktop, knappen på mobil) er minst 16px, så ingenting overlapper */
  @keyframes drop-in {
    from {
      transform: translateY(-10px);
      clip-path: inset(0 0 100% 0);
    }
  }

  @keyframes draw-rule {
    from {
      transform: scaleX(0);
    }
  }

  /* Fortsetter flaten over; luften kommer fra seksjonen før */
  .section-joined {
    padding-top: 0;
  }

  /* Farger */
  .swatch-group + .swatch-group {
    margin-top: 2.5rem;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 0.85rem;
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: var(--fs-body-sm);
  }

  .chip {
    height: 72px;
    margin-bottom: 0.5rem;
    border-radius: var(--r-md);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .meta {
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  /* Typografi */
  .type-grid {
    display: grid;
    gap: 1.75rem;
  }

  .type-row {
    display: grid;
    grid-template-columns: 15rem 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line-on-dark);
  }

  .type-display {
    font-size: var(--fs-display-sm);
  }

  .type-stat {
    font-size: var(--fs-stat);
    font-weight: 700;
    line-height: 1;
  }

  .type-stat small {
    font-size: 0.42em;
    color: var(--muted-on-dark);
    font-weight: 600;
  }

  .type-banner {
    font-family: var(--font-cond);
    font-size: var(--fs-banner);
    font-style: italic;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--red);
  }

  .body-sample {
    max-width: 65ch;
    color: var(--soft-on-dark);
  }

  /* Demo */
  .demo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .stats-row {
    gap: 6px;
  }

  .inline-link {
    font-weight: 600;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .card {
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    padding: 2rem;
  }

  .card-day {
    color: var(--blue);
  }

  .card-h {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--dark);
  }

  .card-p {
    margin-top: 0.35rem;
    font-size: var(--fs-body-sm);
    color: var(--muted);
  }

  .motion-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
