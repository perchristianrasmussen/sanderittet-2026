---
// Sponsorene: logo, kort omtale og lenke, og hvordan man blir sponsor.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sidetopp from '../components/Sidetopp.astro';
import AccentBar from '../components/ui/AccentBar.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { sponsorer } from '../data/sponsorer.ts';
import { epost } from '../data/klubb.ts';

const domene = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<Base
  title="Sponsorer – Sande Sykkelklubb"
  description="Bedriftene som støtter Sande Sykkelklubb og gjør trening og ritt på Lersbrygga mulig."
>
  <Nav />

  <main id="innhold">
    <Sidetopp id="sponsor-tittel">
      <Fragment slot="tittel">Våre <span class="hl">sponsorer</span></Fragment>
      <p class="lead">Tusen takk til alle som støtter Sande Sykkelklubb og gjør aktivitetene våre mulig, fra treningene for barna til Sanderittet og mesterskapene på Lersbrygga.</p>
    </Sidetopp>

    <section class="section on-light" aria-label="Sponsorene">
      <div class="container">
        <ul class="sponsorliste">
          {
            sponsorer.map((s) => (
              <li class="sponsor">
                <div class:list={['logo', `logo-${s.form}`, { 'logo-plate': s.bakgrunn }]} style={{ '--skala': s.skala ?? 1, '--plate': s.bakgrunn }}>
                  <Image src={s.logo} alt="" width={s.form === 'bred' ? 400 : 240} />
                </div>
                <div class="omtale">
                  <h2 class="title">{s.navn}</h2>
                  <p>{s.omtale}</p>
                  <a href={s.url} class="link lenke" target="_blank" rel="noopener">
                    {domene(s.url)}
                    <span class="visually-hidden"> (åpnes i ny fane)</span>
                    <Icon name="external-link" size={16} />
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section on-pale" aria-labelledby="bli-sponsor-tittel">
      <div class="container to-kol">
        <div>
          <h2 id="bli-sponsor-tittel" class="headline">Vil du bli <span class="hl">sponsor</span>?</h2>
          <AccentBar />
          <p class="lead">Interessert i å støtte Sande Sykkelklubb og bli synlig for sykkelfolk i regionen? Ta kontakt med oss.</p>
        </div>
        <div class="panel-blue">
          <h3 class="title">Ta kontakt</h3>
          <AccentBar />
          <p>Send en e-post til leder for sykkelgruppa, så forteller vi mer.</p>
          <Button href={`mailto:${epost}`} icon="mail">Send oss en e-post</Button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .sponsorliste {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-lg) var(--s-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sponsor {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-md);
    align-items: start;
    padding-top: var(--s-md);
    border-top: 1px solid var(--line);
  }

  /* Samme logoflis og optiske skala som på forsiden (sponsorer.ts) */
  .logo {
    --logo-h: 4rem;
    display: grid;
    place-items: center;
    height: 7.5rem;
    padding: var(--s-xs);
    background: var(--white);
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
  }

  .logo-bred {
    --logo-h: 2.4rem;
  }

  .logo :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(var(--logo-h) * var(--skala, 1));
    object-fit: contain;
  }

  .logo-plate :global(img) {
    box-sizing: content-box;
    max-width: calc(85% - 1.5rem);
    padding: 0.45rem 0.75rem;
    background: var(--plate);
    border-radius: var(--r-sm);
  }

  .omtale .title {
    color: var(--dark);
  }

  .omtale p {
    margin-top: 0.4rem;
    color: var(--muted);
    max-width: 52ch;
  }

  .lenke {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-weight: 600;
  }

  .to-kol {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--s-xl);
    align-items: end;
  }

  @media (max-width: 1000px) {
    .sponsorliste,
    .to-kol {
      grid-template-columns: 1fr;
    }

    .to-kol {
      gap: var(--s-lg);
    }
  }

  @media (max-width: 520px) {
    .sponsor {
      grid-template-columns: 1fr;
      gap: var(--s-sm);
    }

    .logo {
      justify-self: start;
      width: 11rem;
    }
  }
</style>
