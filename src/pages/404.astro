---
// Fant ikke siden: kort beskjed og veier videre.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Sidetopp from '../components/Sidetopp.astro';
import Button from '../components/ui/Button.astro';
---

<Base title="Fant ikke siden – Sande Sykkelklubb" noindex>
  <Nav />

  <main id="innhold">
    <Sidetopp id="ikke-funnet">
      <Fragment slot="tittel">Utenfor <span class="hl">løypa</span></Fragment>
      <p class="lead">Vi fant ikke siden du lette etter. Den kan ha flyttet da klubben fikk ny nettside.</p>
      <p class="knapper">
        <Button href="/" icon="arrow-right">Til forsiden</Button>
        <Button href="/trening" variant="outline">Trening</Button>
        <Button href="/sanderittet" variant="outline">Sanderittet</Button>
      </p>
    </Sidetopp>
  </main>

  <Footer />
</Base>

<style>
  .knapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-sm);
    margin-top: var(--s-lg);
  }
</style>
